# Default: use this computer's existing Codex/ChatGPT login. CODEX_MODEL is
# optional; leave it empty to use the Codex CLI's current default model.
TONE_PROVIDER=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=120000

# Optional deployment/compatibility provider. Set TONE_PROVIDER to
# openai-compatible before configuring these values.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-5.1
GLM_TIMEOUT_MS=45000
# Use json_schema only when the configured provider/model supports it.
GLM_RESPONSE_FORMAT=json_object
