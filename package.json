{
  "name": "qc-tone-architect",
  "version": "0.1.0",
  "description": "Local-first AI tone designer and verified USB transfer tool for Neural DSP Quad Cortex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphoristicartist/qc-tone-architect.git"
  },
  "bugs": {
    "url": "https://github.com/aphoristicartist/qc-tone-architect/issues"
  },
  "homepage": "https://github.com/aphoristicartist/qc-tone-architect#readme",
  "packageManager": "pnpm@12.4.2",
  "bin": {
    "qc-tone": "./bin/qc-tone.mjs"
  },
  "keywords": [
    "quad-cortex",
    "guitar",
    "bass",
    "sound-design",
    "tone",
    "codex",
    "usb",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:e2e",
    "audit": "pnpm audit --audit-level=moderate",
    "qc:capture": "tsx scripts/capture-usb.ts",
    "qc": "node bin/qc-tone.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@openai/codex": "^0.155.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "node-hid": "^3.4.0",
    "openai": "7.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "typescript": "^6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
