{
  "name": "qc-tone-architect",
  "version": "0.1.0",
  "description": "Local-first AI tone designer and verified USB transfer tool for Neural DSP Quad Cortex.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphoristicartist/qc-tone-architect.git"
  },
  "bugs": {
    "url": "https://github.com/aphoristicartist/qc-tone-architect/issues"
  },
  "homepage": "https://github.com/aphoristicartist/qc-tone-architect#readme",
  "keywords": [
    "quad-cortex",
    "guitar",
    "bass",
    "sound-design",
    "tone",
    "codex",
    "usb",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:e2e",
    "audit": "npm audit --audit-level=moderate",
    "qc:capture": "tsx scripts/capture-usb.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openai/codex": "^0.151.0",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.7.0",
    "next": "^16.3.5",
    "node-hid": "^3.3.0",
    "openai": "^6.33.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/node-hid": "^1.3.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
